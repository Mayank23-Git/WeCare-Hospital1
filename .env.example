# GEMINI_API_KEY: Required for Gemini AI Doctor Recommendation Assistant.
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY="your_gemini_api_key_here"

# MONGODB_URI: Connection string for MongoDB (MongoDB Atlas or local)
# Example: mongodb+srv://<username>:<password>@cluster0.example.mongodb.net/wecare_hospital
MONGODB_URI="mongodb://localhost:27017/wecare_hospital"

# JWT_SECRET: Secret key for signing admin authentication tokens
JWT_SECRET="wecare_super_secret_jwt_key_2026_secure"

# ADMIN CREDENTIALS: Default admin account credentials
ADMIN_EMAIL="admin@wecarehospital.com"
ADMIN_USERNAME="admin"
ADMIN_PASSWORD="wecareAdmin2026!"

# PORT: Server port (defaults to 3000 in AI Studio)
PORT="3000"

# APP_URL: The URL where this applet is hosted.
APP_URL="http://localhost:3000"

